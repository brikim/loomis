{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch loomis",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "CONFIG_PATH", "value": "C:/tmp/loomis" }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "(Linux/GDB) Launch loomis",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/loomis",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "CONFIG_PATH", "value": "/config" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}